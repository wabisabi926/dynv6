#!/bin/bash
# dynv6 服务管理：start / stop / restart / status
set -u

# 飞牛启动环境可能只给精简 PATH，补齐标准目录，保证 sh/openssl/curl 能被找到
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export PATH

APP="${TRIM_APPDEST:-/var/apps/dynv6/target}"
VAR="${TRIM_PKGVAR:-$APP/var}"
ETC="${TRIM_PKGETC:-$APP/etc}"
SHARES="${TRIM_DATA_SHARE_PATHS:-}"
PORT="${DYNV6_PORT:-8092}"
BIN="$APP/bin/dynv6"
PID_FILE="$VAR/dynv6.pid"
LOG="$VAR/dynv6.log"
ERRLOG="${TRIM_TEMP_LOGFILE:-/dev/stderr}"

mkdir -p "$VAR" "$ETC"
export TRIM_APPDEST="$APP"
export TRIM_PKGVAR="$VAR"
export TRIM_PKGETC="$ETC"
export TRIM_DATA_SHARE_PATHS="$SHARES"
export DYNV6_PORT="$PORT"

# 按绝对路径查找本应用的所有实例（包括升级前遗留、没有 PID 文件的旧进程）。
# 旧版本 stop 时 PID 文件可能已随数据目录重建而丢失，导致进程残留并占住端口。
pids_of_bin() {
    ps -eo pid=,args= 2>/dev/null | awk -v bin="$BIN" '$2 == bin { print $1 }'
}

kill_orphans() {
    pids=$(pids_of_bin)
    [ -n "$pids" ] || return 0
    for p in $pids; do
        kill -TERM "$p" 2>/dev/null || true
    done
    i=0
    while [ -n "$(pids_of_bin)" ] && [ "$i" -lt 20 ]; do
        sleep 0.25
        i=$((i + 1))
    done
    for p in $(pids_of_bin); do
        kill -KILL "$p" 2>/dev/null || true
    done
    sleep 0.2
    return 0
}

port_open() {
    (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null
}

running() {
    [ -f "$PID_FILE" ] || return 1
    pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || { rm -f "$PID_FILE"; return 1; }
    # 避免 PID 复用把无关进程当成应用
    if [ -r "/proc/$pid/cmdline" ]; then
        if ! tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q "dynv6"; then
            rm -f "$PID_FILE"
            return 1
        fi
    fi
    return 0
}

start() {
    if running; then
        return 0
    fi
    if [ ! -x "$BIN" ]; then
        echo "找不到可执行文件 $BIN，请确认安装包架构与设备一致" > "$ERRLOG"
        return 1
    fi
    # 清理升级/卸载遗留的旧实例，避免多个版本同时占用不同端口
    kill_orphans
    rm -f "$PID_FILE"
    # 日志超过 5MB 时保留一份旧日志，避免长期运行无限增长
    if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 5242880 ]; then
        mv -f "$LOG" "$LOG.1" 2>/dev/null || true
    fi
    # 日志由应用自身写入 $LOG 并轮转；这里不再重定向 stdout，避免重复写同一文件
    nohup "$BIN" >>/dev/null 2>&1 &
    echo $! > "$PID_FILE"
    i=0
    while [ "$i" -lt 40 ]; do
        if port_open; then
            return 0
        fi
        if ! running; then
            echo "服务进程退出，请查看日志 $LOG" > "$ERRLOG"
            return 1
        fi
        sleep 0.25
        i=$((i + 1))
    done
    echo "服务启动超时（端口 $PORT），请查看日志 $LOG" > "$ERRLOG"
    return 1
}

stop() {
    if running; then
        pid=$(cat "$PID_FILE" 2>/dev/null)
        kill -TERM "$pid" 2>/dev/null || true
        i=0
        while running && [ "$i" -lt 20 ]; do
            sleep 0.25
            i=$((i + 1))
        done
        running && kill -KILL "$pid" 2>/dev/null || true
    fi
    # PID 文件缺失或被重建时也能停掉旧实例
    kill_orphans
    rm -f "$PID_FILE"
    return 0
}

case "${1:-}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)
        if running || [ -n "$(pids_of_bin)" ]; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "用法: main {start|stop|restart|status}" > "$ERRLOG"
        exit 1
        ;;
esac
exit $?
